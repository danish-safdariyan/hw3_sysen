# Copy to .env and adjust. Never commit .env.

# ollama | openai
HW3_AI_PROVIDER=ollama

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
HW3_OLLAMA_TEMPERATURE=0.8

# OpenAI (cloud) — only if HW3_AI_PROVIDER=openai
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HW3_OPENAI_TEMPERATURE=0.8

# Experiment
HW3_N_REPLICATES=30
HW3_SLEEP_SECONDS=0.25
HW3_SAVE_FULL_REPORTS=true
